EXPO_PUBLIC_API_BASE_URL_DEV=http://localhost:8000
EXPO_PUBLIC_API_BASE_URL_PROD=https://api.example.com
EXPO_PUBLIC_FRONTEND_URL=https://invoyq.com

# Google Sign-In (native). Create the three OAuth clients in Google Cloud Console, see
# GOOGLE-OAUTH-SETUP.md. If the Web or iOS id is missing, the Google button is hidden.
# Android needs no id here: Google matches the Android client by package name + SHA-1.
# The Web client id must be the same one the backend uses as GOOGLE_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=your-ios-client-id.apps.googleusercontent.com
